# Configuración local de referencia. No contiene secretos.
# Copiar a .env en desarrollo; jamás incorporar .env al repositorio.
APP_ENV=development
APP_NAME=Entrenador de Prompts
APP_TIMEZONE=America/Argentina/Cordoba
PUBLIC_ORIGIN=http://127.0.0.1:5173
API_PREFIX=/api/v1
VITE_API_BASE_URL=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_DEV_PORT=5173

# Desarrollo local en Windows: PostgreSQL instalado, no un contenedor.
# Construir DATABASE_URL en el backend a partir de estas variables. URL-encode de
# usuario/clave al construirla y no registrar la URL completa.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=entrenador_prompts
POSTGRES_TEST_DB=entrenador_prompts_test
POSTGRES_USER=entrenador_app
POSTGRES_PASSWORD=
# Sólo Alembic, seeds y preparación de fixtures de pruebas. Nunca en FastAPI.
MIGRATION_USER=entrenador_migracion
MIGRATION_PASSWORD=
# Alternativa administrada: URL completa inyectada por el proveedor; nunca en VITE_*.
DATABASE_URL=
# Solo pruebas de integración: si está vacía se construye con POSTGRES_TEST_DB y
# POSTGRES_PASSWORD. Nunca usar la base de desarrollo para estas pruebas.
TEST_DATABASE_URL=

SESSION_COOKIE_NAME=ep_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
PASSWORD_RESET_MINUTES=15
REVIEW_TOKEN_MINUTES=10
# Clave aleatoria de al menos 32 bytes, generar localmente. Obligatoria.
# Etapa 04: scripts/prepare_review_secrets.py completa sólo revisión/huellas ausentes.
# Nunca imprimir claves ni rotar las existentes como parte de un arranque normal.
REVIEW_SIGNING_KEY=
CSRF_SIGNING_KEY=
# Clave independiente para comparar alertas sin conservar fragmentos adicionales.
ALERT_FINGERPRINT_KEY=
ALERT_FINGERPRINT_KEY_VERSION=1

# Capturador SMTP local para desarrollo. Mailpit escucha en 127.0.0.1:1025 y su
# interfaz queda en http://127.0.0.1:8025. La app no registra tokens de recuperación.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=no-reply@example.invalid

# Operación local protegida; prepare_operation_local.py completa rutas ausentes.
# Referencias del contrato, no un cron local: Task Scheduler calcula 02:00 Cordoba.
# Los scripts aplican la política fija 7 días/4 semanas y máximo 30 días.
BACKUP_TIMEZONE=America/Argentina/Cordoba
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
B2_ENDPOINT_URL=
B2_ENABLED=false
B2_BUCKET=
B2_BUCKET_ID=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Adaptador Native v4 exige bucket privado y clave limitada a entrenador-prompts/.
# No se contacta B2 durante arranque, pruebas ni respaldos locales.
# Destinatario público age. Identidad privada separada del repo y del destino.
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_DIRECTORY=
# Verificación/restore local; privada fuera del repo/destino. Custodia offline
# separada del servidor requerida al preparar un despliegue.
BACKUP_IDENTITY_FILE=
DELETION_JOURNAL_LOCATION=
DELETION_JOURNAL_KEY_FILE=
DELETION_JOURNAL_ANCHOR_FILE=

LOG_LEVEL=INFO
LOG_REQUEST_BODIES=false
SEED_DEMO_DATA=false
